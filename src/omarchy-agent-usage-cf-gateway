#!/usr/bin/env python3
"""Omarchy agents panel collector for CF AI Gateway + MiMo Token Plan.

Wraps the unified collector into the JSON schema the Omarchy agents panel expects.
Install as:
  ~/.local/bin/omarchy-agent-usage-cf-gateway
  or symlink into /usr/share/omarchy/bin/
"""

import json
import sys
from pathlib import Path
import importlib.util

# Find the collector — try relative to script, then ~/.local/bin
_script_dir = Path(__file__).parent
COLLECTOR = _script_dir / "collector.py"
if not COLLECTOR.exists():
    COLLECTOR = Path.home() / ".local" / "bin" / "cf-ai-gateway-collector"

def main():
    try:
        # Add collector's directory to sys.path and import by filename
        collector_path = Path(COLLECTOR)
        if not collector_path.exists():
            raise FileNotFoundError(f"Collector not found: {COLLECTOR}")

        # Read and exec the collector module
        import types
        mod = types.ModuleType("collector")
        mod.__file__ = str(collector_path)
        exec(compile(collector_path.read_text(), str(collector_path), "exec"), mod.__dict__)

        cfg = mod.load_config()
        record = mod.collect(cfg)
        print(json.dumps(record))
    except Exception as e:
        from datetime import datetime, timedelta, timezone
        now = datetime.now(timezone.utc)
        dates = [(now - timedelta(days=i)).strftime("%Y-%m-%d") for i in range(6, -1, -1)]
        record = {
            "schemaVersion": 1,
            "id": "cf-ai-gateway",
            "name": "CF AI Gateway",
            "updatedAt": now.isoformat(),
            "ready": False,
            "hasLocalStats": True,
            "usageStatusText": f"Error: {e}",
            "authHelpText": "Configure ~/.config/cf-ai-gateway/config.json",
            "todayPrompts": 0, "todaySessions": 0,
            "todayTotalTokens": 0, "todayTokensByModel": {},
            "recentDays": [{"date": d, "messageCount": 0} for d in dates],
            "totalPrompts": 0, "totalSessions": 0,
            "activeDays": 0, "activeDates": [],
            "modelUsage": {}, "limits": [], "tierLabel": "",
        }
        print(json.dumps(record))

if __name__ == "__main__":
    main()
