#!/bin/bash
# Omarchy agents panel collector for CF AI Gateway + MiMo Token Plan.
#
# Thin wrapper around collector.py — no Python overhead, no exec(), no
# bypassing the cache. collector.py's main() handles caching (30min TTL).
#
# Install:
#   cp src/omarchy-agent-usage-cf-gateway ~/.local/bin/
#   chmod +x ~/.local/bin/omarchy-agent-usage-cf-gateway
#   sudo ln -sf ~/.local/bin/omarchy-agent-usage-cf-gateway /usr/share/omarchy/bin/

COLLECTOR="$HOME/.local/bin/cf-ai-gateway-collector"

if [ ! -f "$COLLECTOR" ]; then
    # Try relative to this script
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    COLLECTOR="$SCRIPT_DIR/collector.py"
fi

if [ ! -f "$COLLECTOR" ]; then
    NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    cat <<EOF
{"schemaVersion":1,"id":"cf-ai-gateway","name":"CF AI Gateway","updatedAt":"$NOW","ready":false,"hasLocalStats":true,"usageStatusText":"Collector not found: $COLLECTOR","authHelpText":"Run setup.sh from cf-ai-gateway-tracker repo","todayPrompts":0,"todaySessions":0,"todayTotalTokens":0,"todayTokensByModel":{},"recentDays":[],"totalPrompts":0,"totalSessions":0,"activeDays":0,"activeDates":[],"modelUsage":{},"limits":[],"tierLabel":""}
EOF
    exit 0
fi

exec python3 "$COLLECTOR"
