#!/bin/bash
# XFCE genmon widget for CF AI Gateway + MiMo Token Plan usage.
#
# Uses the collector's disk cache — never makes HTTP requests directly.
# The collector refreshes every 30 minutes; this just reads the cached JSON.

CACHE="$HOME/.cache/cf-ai-gateway/collector.json"
COLLECTOR="$HOME/.local/bin/cf-ai-gateway-collector"

# If cache is stale or missing, trigger a background refresh (non-blocking)
if [ ! -f "$CACHE" ] || [ $(find "$CACHE" -mmin +30 2>/dev/null | wc -l) -gt 0 ]; then
    python3 "$COLLECTOR" --live >/dev/null 2>&1 &
fi

# Read cached data
if [ -f "$CACHE" ]; then
    python3 -c "
import json, sys
try:
    d = json.load(open('$CACHE'))
    parts = []
    limits = d.get('limits', [])
    if limits:
        pct = limits[0].get('percent', 0) * 100
        parts.append(f'MiMo {pct:.0f}%')
    gw = d.get('gateways', [])
    if gw:
        parts.append(f'CF {len(gw)} gw')
    today = d.get('todayTotalTokens', 0)
    if today > 0:
        if today >= 1_000_000:
            parts.append(f'{today/1_000_000:.0f}M today')
        else:
            parts.append(f'{today/1_000:.0f}K today')
    text = ' · '.join(parts) if parts else 'AI: no data'
    tier = d.get('tierLabel', '')
    print(f'<txt>{text}</txt>')
    print(f'<tool>CF AI Gateway: {len(gw)} gateways\n{tier}</tool>')
except Exception:
    print('<txt>AI: error</txt>')
" 2>/dev/null
else
    echo "<txt>AI: no cache</txt>"
    echo "<tool>Run: python3 ~/.local/bin/cf-ai-gateway-collector --test</tool>"
fi

echo "<icon>utilities-terminal</icon>"
